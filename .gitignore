# Dependencies
node_modules/

# Build output
dist/

# Rust build output
target/
artifacts/
.test-server/
benchmark-results/

# Environment / secrets — NEVER commit these
.env
.env.*
!.env.example
!.env.native.example

# Minecraft / Microsoft auth token cache (MC_PROFILES_PATH) — NEVER commit these.
# render.yaml points MC_PROFILES_PATH at src/.minecraft-auth (inside the tracked
# source tree); the cache holds Microsoft access tokens.
.minecraft-auth/
.minecraft/
launcher_accounts.json
*-cache.json

# Logs
logs/
*.log
npm-install.log
npm-install.err.log

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Runtime state (persistent memory snapshots)
data/
*.local.json

# The generated item properties are a BUILD INPUT: the Rust test embeds the
# JSON at compile time, so it has to be tracked like its generated Rust twin
# (native/src/item_defaults.rs). Everything else under native/data stays out.
!native/data/
native/data/*
!native/data/items-*.json

# Test output
coverage/
test-out.txt
smoke*.txt
t.txt

# Transient scratch output from tooling
eslint-*.txt
final-vitest.txt
vitest-*.json

# Root-level scratch probes (throwaway developer scripts, not part of the build)
.scratch-*.ts
