// ---------------------------------------------------------------------------
// Minecraft connection
// ---------------------------------------------------------------------------
// Aternos: use the address shown in your server panel (e.g. myserver.aternos.me).
// Leave MC_PORT at 25565 unless your panel says otherwise - minecraft-protocol
// only performs the SRV lookup Aternos relies on when the port is the default.
MC_HOST=myserver.aternos.me
MC_PORT=25565
# Username the bot logs in with. On Aternos, whitelist this name if the server
# has the whitelist enabled, or the join is rejected as fatal (never retried).
MC_USERNAME=MyAssistantBot
# Auth mode: "microsoft" (recommended) or "offline" (offline-mode servers only).
# "offline" is isolated behind configuration on purpose - never default to it.
# Most Aternos servers run in online-mode, which needs MC_AUTH=microsoft.
MC_AUTH=microsoft
# Leave empty to auto-detect the server's version (recommended: Aternos updates
# and version switches then require no config change). Pin a version only when
# auto-detect misbehaves; a wrong pin ends in an "outdated server" kick.
MC_VERSION=
# Optional first-time device-code login cache directory (Microsoft tokens).
MC_PROFILES_PATH=
# How long to wait for the first spawn before a connection attempt fails.
# Aternos free servers can be slow to hand out the spawn packet; raise to
# 90000-120000 if you see "waiting for spawn" timeouts on startup.
MC_SPAWN_TIMEOUT_MS=60000

// ---------------------------------------------------------------------------
// Authorization — comma separated Minecraft usernames allowed to give orders.
// Everyone else may talk, but their messages are never treated as instructions.
// ---------------------------------------------------------------------------
AUTHORIZED_PLAYERS=Shreeharsh,Friend1

// ---------------------------------------------------------------------------
// Chat
// ---------------------------------------------------------------------------
# Prefix that marks a deterministic (non-AI) command.
BOT_PREFIX=!

// ---------------------------------------------------------------------------
// AI providers — order defines fallback priority.
// Pick any subset; unconfigured providers are skipped automatically.
// ---------------------------------------------------------------------------
AI_PROVIDER_PRIORITY=groq,gemini,openai,openrouter

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Planning request budget in milliseconds. Hard ceiling, requests are aborted at it.
AI_REQUEST_TIMEOUT_MS=20000
# Model tier used for multi-step planning (may be a stronger/slower provider).
AI_PLANNING_MODEL=
# Consecutive failures before a provider's circuit breaker opens.
AI_CIRCUIT_FAILURE_THRESHOLD=3
# How long a tripped provider stays out of the pool, in milliseconds.
AI_CIRCUIT_COOLDOWN_MS=60000
# Max AI plans processed per second across the whole bot.
AI_MAX_CONCURRENT_REQUESTS=2

# ---------------------------------------------------------------------------
// Aternos safe mode — this bot is NOT an AFK keep-alive.
// The owner starts the server manually; the bot is a normal client.
// When no authorized human has been online for HUMAN_TIMEOUT_SECONDS the bot
// disconnects itself so it can never be used to hold an idle server awake.
// ---------------------------------------------------------------------------
DISCONNECT_WITHOUT_HUMANS=true
HUMAN_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
// Runtime
// ---------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=pretty
# Directory for the persistent memory snapshot. Empty = in-memory only.
MEMORY_FILE=./data/memory.json
# Max reconnect attempts for connection loss (exponential backoff). 0 disables.
# Aternos restarts routinely; the default 5 attempts over ~2.5 minutes ride out
# a typical free-server restart. Raise this if your server stays down longer.
MAX_RECONNECT_ATTEMPTS=5
RECONNECT_BASE_DELAY_MS=5000

# Hard safety ceilings (0 disables the corresponding limit).
MAX_ACTIONS_PER_MINUTE=120
MAX_MINING_BLOCKS_PER_TASK=512
MAX_BUILD_BLOCKS_PER_TASK=256
FOLLOW_DISTANCE=3