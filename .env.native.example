# Native Rust runtime: Java 1.21.4 / protocol 769 only.
# Copy to .env after reviewing; no AI key is required for deterministic commands.
MC_HOST=myserver.aternos.me
MC_PORT=25565
MC_USERNAME=MyAssistantBot
MC_AUTH=microsoft
MC_VERSION=1.21.4
# Optional Microsoft account email used as a cache identifier, never sent to AI.
MC_MICROSOFT_EMAIL=
MC_PROFILES_PATH=./data/auth
MC_SPAWN_TIMEOUT_MS=60000

AUTHORIZED_PLAYERS=Shreeharsh,Friend1
# Optional trustworthy online-mode UUID pinning: name=uuid,name=uuid.
AUTHORIZED_UUIDS=
BOT_PREFIX=!

AI_PROVIDER_PRIORITY=groq,gemini,openai,openrouter
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional comma-separated multiple keys: PROVIDER_API_KEYS overrides singular key.
GROQ_API_KEYS=
GEMINI_API_KEYS=
OPENAI_API_KEYS=
OPENROUTER_API_KEYS=
AI_REQUEST_TIMEOUT_MS=20000
AI_PLANNING_MODEL=
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_COOLDOWN_MS=60000
AI_MAX_CONCURRENT_REQUESTS=2

DISCONNECT_WITHOUT_HUMANS=true
HUMAN_TIMEOUT_SECONDS=60
# Vanilla tab-list player identities are server-wide. Plugins that hide players
# make this evidence unreliable; false fails closed after the grace period.
TRUST_SERVER_TAB_LIST=true
# Mandatory 0 on Aternos. Other servers: bounded recovery additionally needs
# a fresh authorized external presence lease; default remains 0.
MAX_RECONNECT_ATTEMPTS=0
RECONNECT_BASE_DELAY_MS=5000

MAX_ACTIONS_PER_MINUTE=120
MAX_MINING_BLOCKS_PER_TASK=512
MAX_BUILD_BLOCKS_PER_TASK=256
FOLLOW_DISTANCE=3
TASK_TIMEOUT_SECONDS=600
# Explicit container access, separated by semicolons. Empty refuses all transfers.
# AUTHORIZED_CONTAINERS=minecraft:overworld@10,64,20;minecraft:overworld@11,64,20
AUTHORIZED_CONTAINERS=
# Protect regions in each dimension: dimension@minX,minY,minZ,maxX,maxY,maxZ.
# PROTECTED_REGIONS=minecraft:overworld@0,60,0,30,90,30
PROTECTED_REGIONS=
MEMORY_FILE=./data/memory-native.json
LOG_LEVEL=info
LOG_FORMAT=pretty
